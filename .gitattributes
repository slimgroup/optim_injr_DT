# Normalize source files; leave research binaries untouched.
* text=auto
*.jl text eol=lf
*.py text eol=lf diff=python
*.sh text eol=lf
*.md text diff=markdown
*.toml text
*.yml text
*.yaml text
*.json text
*.cff text
*.csv text
*.txt text
*.svg binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.mp4 binary
*.jld2 binary
*.h5 binary
*.hdf5 binary
*.npz binary
*.npy binary
*.zip binary
*.gz binary
